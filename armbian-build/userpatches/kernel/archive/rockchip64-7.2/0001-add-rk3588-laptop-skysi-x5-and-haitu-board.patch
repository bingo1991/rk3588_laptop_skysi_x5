+static void SortBubble(int t[],int size)
+{
+	int temp = 0;
+	int m,n;
+	for(m=0;m<size;m++)
+	{
+		for(n=m+1;n<size;n++)
+		{
+			temp = t[m];
+			if (temp>t[n])
+			{
+				t[m] = t[n];
+				t[n] = temp;
+			}
+		}
+	}
+}

+static unsigned int PointDistance(gsl_POINT_TYPE *p1,gsl_POINT_TYPE *p2)
+{
+	int a,b,ret;
+	a = p1->dis.x;
+	b = p2->dis.x;
+	ret = (a-b)*(a-b);
+	a = p1->dis.y;
+	b = p2->dis.y;
+	ret += (a-b)*(a-b);
+	return ret;
+}

+			+ ((int)gesture_buf[n].other.y - (int)gesture_buf[n - 1].other.y)
+			* ((int)len_total*i/(GESTURE_SIZE_NUM-1) - (int)len_his + (int)len_now)
+			/ (int)len_now
+			;
+		if(t < 0)
+			t = 0;
+		gesture_standard[i].other.y = t;
+		n--;

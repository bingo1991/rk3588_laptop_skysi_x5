+		compatible = "brcm,bcm4362a2-bt", "brcm,bcm43430a1-bt";
+		clocks = <&hym8563>;
+		clock-names = "lpo";
+		device-wakeup-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
+		shutdown-gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_reset_gpio>, <&bt_wake_gpio>, <&bt_irq_gpio>;
+		vbat-supply = <&vcc_3v3_s3>;
+		vddio-supply = <&vccio_1v8_s3>;
+		firmware-name = "brcm/BCM4362A2.hcd";
+		status = "okay";
+	};
+	
+	bt_rtk: bluetooth-rtk {
+		compatible = "realtek,rtl8852bs-bt", "realtek,rtl8822cs-bt";
+		device-wakeup-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_HIGH>;
+		shutdown-gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
+		vbat-supply = <&vcc_3v3_s3>;
+		vddio-supply = <&vccio_1v8_s3>;

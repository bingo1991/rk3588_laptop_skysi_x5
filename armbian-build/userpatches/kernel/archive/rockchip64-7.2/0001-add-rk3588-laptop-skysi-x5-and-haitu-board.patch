+	u8 nfs;			//nfs mode, =0, nfs mode disabled
+	u8 osr;			//adc over sample rate
+	u8 prediv_premulti;	//adcclk and dacclk divider
+	u8 cf_dsp_div;		//adclrck divider and daclrck divider
+	u8 scale;
+};

+static inline int get_mclk_lrck_ratio(int clk_ratio, int n_fs)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ratio_div); i++) {
+		if (ratio_div[i].ratio == clk_ratio
+		    && ratio_div[i].nfs == n_fs)
+
+			return i;
+	}
+
+	return -EINVAL;
+}
